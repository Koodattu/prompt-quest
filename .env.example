# PromptQuest local configuration
#
# Copy this file to .env in the repository root before running:
# docker compose up

# Database container
POSTGRES_DB=promptquest
POSTGRES_USER=promptquest
POSTGRES_PASSWORD=promptquest

# Backend
APP_SECRET=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=4000

# Initial seeded passwords. These are only inserted when the seed rows do not
# already exist in the database volume.
SEED_PARTICIPANT_PASSWORD=demo
SEED_ADMIN_PASSWORD=admin-demo

# AI providers
# Gemini is the default admin setting. Use Google AI Studio / Gemini API key.
GOOGLE_API_KEY=

# Optional. Set this and switch provider to "openai" in the admin panel.
OPENAI_API_KEY=

# Backend AI diagnostics and Gemini tuning
AI_DEBUG_LOGS=true
GEMINI_MAX_OUTPUT_TOKENS=1400
GEMINI_THINKING_LEVEL=minimal
# Options: BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE,
# BLOCK_NONE, OFF. BLOCK_ONLY_HIGH is a reasonable demo default.
GEMINI_SAFETY_THRESHOLD=BLOCK_ONLY_HIGH

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
